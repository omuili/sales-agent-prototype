# Required
OPENAI_API_KEY=sk-...

# Models (any chat model your key can access; see sidebar dropdown)
OPENAI_FAST_MODEL=gpt-5-mini
OPENAI_SMART_MODEL=gpt-5

# Optional: better search results (free tier at tavily.com). Falls back to DuckDuckGo when unset.
TAVILY_API_KEY=

# SEC asks automated clients to identify themselves: "app-name your-email@domain.com"
SEC_USER_AGENT=cap-931-sales-agent research@example.com

# Optional: email delivery for keyword alerts (Gmail: use an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Name on the Per Scholas template cover of generated documents
LEARNER_NAME=Olanrewaju Muili
